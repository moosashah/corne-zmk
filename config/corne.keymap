  #include <behaviors.dtsi>
  #include <dt-bindings/zmk/keys.h>
  #include <dt-bindings/zmk/bt.h>
  #include <dt-bindings/zmk/ext_power.h>

#define DEFAULT 0
#define NUM 1
#define FUNC 2

  &mt {
   flavor = "tap-preferred";
   tapping_term_ms = <170>;
};


  / {
    keymap {
      compatible = "zmk,keymap";
  default_layer {
          bindings = <
          &none &kp Q &kp W &kp E &kp R &kp T                       &kp Y &kp U &kp I &kp O &kp P &none
          &kp TAB &kp A &kp S &mt LALT D &mt LCMD F &kp G           &kp H &mt RCMD J &mt RALT K &kp L &kp SEMI &kp SINGLE_QUOTE 
          &none  &mt LS(LC(LA(LCMD))) Z &kp X &kp C &kp V &kp B     &kp N &kp M &kp COMMA &kp DOT &kp SLASH &kp RIGHT_SHIFT 
          &none &lt FUNC BACKSPACE &mt LEFT_SHIFT SPACE             &lt NUM RET &mt RCTRL ESC &none
          >;
        };
        num_layer {
          bindings = <
          &none &kp BSLH  &kp HASH  &kp DOLLAR &kp GRAVE  &none                                   &none &kp N7 &kp N8 &kp N9 &kp N0 &none 
          &none &kp MINUS &kp LT &kp LPAR &mt LCMD LEFT_BRACKET &none                        &none &mt RCMD N4 &mt RALT N5 &kp N6 &kp SINGLE_QUOTE &none
          &kp LEFT_SHIFT &mt LS(LC(LA(LCMD))) EQUAL &kp GT	&kp RPAR  &kp RBKT &none               &kp DOT &kp N1 &kp N2 &kp N3 &kp SLASH &none
          &none &kp BACKSPACE &mt LEFT_SHIFT SPACE                                                     &trans &none &none
          >;
        };
        func_layer {
          bindings = <
          &none &kp LS(LG(LC(N4)))  &kp C_BRI_INC  &kp C_VOL_UP &kp C_NEXT &none                 &none &kp RC(RS(N6)) &none &none &none &none 
          &none &mt LSFT TAB &kp LS(TAB)  &mt LALT K_MUTE &mt LCMD C_PLAY_PAUSE &none            &kp LEFT &kp DOWN &kp UP &kp RIGHT &none &none 
          &none &kp LS(LG(N4)) &kp C_BRI_DEC &kp C_VOL_DN &kp C_PREV &none                       &none &kp LC(LS(N6)) &kp RC(RS(TAB)) &kp RC(TAB) &none &none
          &none &trans &none                                                                     &kp ENTER &mt RCTRL ESC &none
          >;
        };
    };
  };
  

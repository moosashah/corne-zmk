  #include <behaviors.dtsi>
  #include <dt-bindings/zmk/keys.h>
  #include <dt-bindings/zmk/bt.h>
  #include <dt-bindings/zmk/ext_power.h>

  / {
    keymap {
      compatible = "zmk,keymap";
  layer0 {
          bindings = <
          &none &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &none &kp TAB &kp A &kp S &mt LEFT_ALT D &mt LEFT_GUI F &kp G &kp H [[RGUI_T(KC_J)]] [[RALT_T(KC_K)]] &kp L &kp SEMICOLON &kp SINGLE_QUOTE &kp LEFT_SHIFT [[ALL_T(KC_Z)]] &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp SLASH &kp RIGHT_SHIFT &kp LEFT_SHIFT &lt 2 BACKSPACE &mt LEFT_SHIFT SPACE &lt 1 ENTER [[RCTL_T(KC_ESC)]] &none
          >;
        };layer1 {
          bindings = <
          &none &kp BACKSLASH [[KC_HASH]] [[KC_DLR]] &kp GRAVE &none &none &kp N7 &kp N8 &kp N9 &kp N0 &none &none &kp MINUS [[KC_LT]] [[KC_LPRN]] &mt LEFT_GUI LEFT_BRACKET &none &none [[RGUI_T(KC_4)]] [[RALT_T(KC_5)]] &kp N6 &kp SINGLE_QUOTE &none &kp LEFT_SHIFT [[ALL_T(KC_EQL)]] [[KC_GT]] [[KC_RPRN]] &kp RIGHT_BRACKET &none &kp DOT &kp N1 &kp N2 &kp N3 &kp SLASH &kp RIGHT_SHIFT &none &kp BACKSPACE &mt LEFT_SHIFT SPACE &trans &none &none
          >;
        };layer2 {
          bindings = <
          &none S(G(C(KC_4 &kp C_BRIGHTNESS_INC &kp C_VOLUME_UP &kp C_FAST_FORWARD &kp K_CUT &none &kp RC(RS(N6)) &none &none &none &none &none &mt LEFT_SHIFT TAB &kp LEFT_CONTROL [[RALT_T(KC_MUTE)]] &mt LEFT_GUI C_PLAY_PAUSE &kp K_COPY &kp LEFT &kp DOWN &kp UP &kp RIGHT &none &none &none S(G(KC_4 &kp C_BRIGHTNESS_DEC &kp C_VOLUME_DOWN &kp C_REWIND &kp K_PASTE &none &kp RC(RS(TAB)) &kp LC(TAB) &none &none &none &none &trans &none &kp ENTER [[RCTL_T(KC_ESC)]] &none
          >;
        };
    };
  };
  
